// URL fields store hostnames only: no scheme, path, or trailing slash.
// project.yml composes https:// values for the app Info.plist; the Makefile
// composes https:// values for CLI and integration-test runs.
// Do not write https://... here: xcconfig treats // as a comment and silently
// truncates the value to https:.
// Boolean fields use lowercase true or false only.

CATVOX_PROJECT_ID = kathelix-catvox-dev-2
CATVOX_ENVIRONMENT = dev
// Environment security tier (ADR-0026). false = mutable: debug token allowed,
// App Check may be UNENFORCED, WIF trusts any ref, integration tests permitted.
// true = protected: App Check ENFORCED, WIF ref pinned, no debug token,
// non-invasive smoke only.
CATVOX_ENVIRONMENT_PROTECTED = false
CATVOX_FUNCTION_REGION = us-central1
CATVOX_FIRESTORE_LOCATION = nam5
CATVOX_TF_STATE_BUCKET = catvox-tf-state-kathelix-catvox-dev-2
CATVOX_GCP_CI_SERVICE_ACCOUNT = catvox-ci-sa@kathelix-catvox-dev-2.iam.gserviceaccount.com
CATVOX_GCP_WIF_PROVIDER = projects/229534242423/locations/global/workloadIdentityPools/github-actions-pool/providers/github-actions-provider
// WIF ref pin: empty trusts any ref. See ADR-0024.
CATVOX_GCP_WIF_GITHUB_REF =
CATVOX_IOS_BUNDLE_ID = com.kathelix.catvox.dev
CATVOX_FIREBASE_IOS_APP_DISPLAY_NAME = CatVox Dev iOS
CATVOX_FIREBASE_IOS_APP_DELETION_POLICY = DELETE
CATVOX_FIREBASE_APPLE_TEAM_ID = QYT76L5836
// Firestore App Check enforcement. Mutable environments use UNENFORCED so the
// debug-token path is frictionless; service-account/Admin access bypasses App
// Check. See ADR-0025.
CATVOX_FIREBASE_FIRESTORE_APP_CHECK_ENFORCEMENT = UNENFORCED
CATVOX_MANAGE_GCF_SOURCES_BUCKET_IAM = true
CATVOX_SIGNED_UPLOAD_URL_HOST = getsigneduploadurl-2orfuuynna-uc.a.run.app
CATVOX_ANALYSE_VIDEO_HOST = analysevideo-2orfuuynna-uc.a.run.app
CATVOX_FIREBASE_APP_ID = 1:229534242423:ios:3d9eb37b78711fefd8d872
CATVOX_FIREBASE_API_KEY = AIzaSyDsYQHNJvvgbIArE7jkIa0CH5nJ0GzBk4Q
CATVOX_POSTHOG_PROJECT_TOKEN = phc_rW9MvjE8ykYcP2Aa3vmDuLjmwgKt22axYujtHtZThtC3
CATVOX_POSTHOG_HOST_NAME = us.i.posthog.com
CATVOX_POSTHOG_API_HOST_NAME = us.posthog.com
CATVOX_POSTHOG_PROJECT_ID = 720088
CATVOX_POSTHOG_ORGANIZATION_ID = 019dd8f1-bb9a-0000-0b42-cc4eed1ae14f
CATVOX_INTEGRATION_SAFE_ENVIRONMENTS = dev
